{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# One-shot system setup: libvirtd, shell, zinit, autostart, manual installs.
set -euo pipefail

echo "==> Upgrading system..."
sudo dnf upgrade -y

echo "==> Enabling libvirtd..."
sudo systemctl enable --now libvirtd
sudo usermod -aG libvirt "$USER"
sudo virsh net-autostart default >/dev/null 2>&1 || true

if [ "$SHELL" != "/bin/zsh" ]; then
  echo "==> Setting login shell to zsh..."
  sudo chsh -s /bin/zsh "$USER"
fi

ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
if [ ! -d "$ZINIT_HOME" ]; then
  echo "==> Installing zinit..."
  mkdir -p "$(dirname "$ZINIT_HOME")"
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# chezmoi_modify_manager: needed by the modify_ scripts during `chezmoi apply`.
# Installed into ~/.local/bin, which both ~/.bashrc (bootstrap) and dot_zshrc
# put on PATH, so the modify_ script's `env` shebang resolves it. Must be
# installed before any files are applied, hence this before_ script.
CMM_VERSION="v3.7.1"
if [ ! -x "$HOME/.local/bin/chezmoi_modify_manager" ]; then
  echo "==> Installing chezmoi_modify_manager ${CMM_VERSION}..."
  mkdir -p "$HOME/.local/bin"
  cmm_tmp=$(mktemp -d)
  curl -fsSL -o "$cmm_tmp/cmm.tar.gz" \
    "https://github.com/VorpalBlade/chezmoi_modify_manager/releases/download/${CMM_VERSION}/chezmoi_modify_manager-${CMM_VERSION}-x86_64-unknown-linux-gnu.tar.gz"
  tar -xzf "$cmm_tmp/cmm.tar.gz" -C "$cmm_tmp"
  install -m 0755 "$cmm_tmp/chezmoi_modify_manager" "$HOME/.local/bin/chezmoi_modify_manager"
  rm -rf "$cmm_tmp"
fi

if [ ! -x "$HOME/.local/bin/kubelogin" ]; then
  echo "==> Installing kubelogin..."
  mkdir -p "$HOME/.local/bin"
  az aks install-cli \
    --install-location /tmp/kubectl-discard \
    --kubelogin-install-location "$HOME/.local/bin/kubelogin"
  rm -f /tmp/kubectl-discard
fi

if ! command -v flux >/dev/null; then
  echo "==> Installing Flux CLI..."
  curl -s https://fluxcd.io/install.sh | sudo bash
fi

if [ ! -x "$HOME/.opencode/bin/opencode" ]; then
  echo "==> Installing opencode..."
  curl -fsSL https://opencode.ai/install | bash
fi

if [ ! -x "$HOME/.local/bin/jetbrains-toolbox" ]; then
  echo "==> Installing JetBrains Toolbox..."
  mkdir -p "$HOME/.local/bin"
  curl -sL -o /tmp/jetbrains-toolbox.tar.gz \
    "https://data.services.jetbrains.com/products/download?platform=linux&code=TBA"
  tar -xzf /tmp/jetbrains-toolbox.tar.gz -C "$HOME/.local/bin" --strip-components=1
  rm /tmp/jetbrains-toolbox.tar.gz
fi
{{- end }}
